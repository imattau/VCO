{
  "name": "@vco/vco-relay",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "vco-relay": "dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "start": "node dist/main.js",
    "test": "vitest run",
    "clean": "rm -rf dist .tsbuildinfo"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "^15.0.0",
    "@chainsafe/libp2p-quic": "^1.1.8",
    "@chainsafe/libp2p-yamux": "^7.0.4",
    "@libp2p/identify": "^3.0.0",
    "@libp2p/crypto": "^5.0.0",
    "@libp2p/kad-dht": "^14.0.0",
    "@libp2p/mdns": "^11.0.0",
    "@libp2p/tcp": "^10.0.0",
    "@libp2p/websockets": "^9.0.0",
    "@vco/vco-core": "0.1.0",
    "@vco/vco-sync": "0.1.0",
    "@vco/vco-transport": "0.1.0",
    "classic-level": "^1.4.1",
    "libp2p": "^2.10.0",
    "multiformats": "^13.4.2",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.9",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
